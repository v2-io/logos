#!/usr/bin/env ruby
#
# bin/build — assemble a paper from an OUT.*.md manifest into Inquiry / T&F
# submission targets (DOCX primary; PDF preview).
#
# Status (2026-05-09 — minimum-viable port):
#   - Wired:  manifest parsing, segment concat, refs emission, pandoc → DOCX,
#             pandoc → PDF (preview), Chicago author-date CSL, basic
#             anonymisation lint at build time.
#   - Stubbed: NeurIPS-style Obsidian callouts (kramdown parser/converter),
#              theorem environments, [[#^anchor]] cross-refs, equation
#              anchors. The Inquiry/T&F target doesn't need them — analytic-
#              philosophy prose has no theorems / aligned equations / heavy
#              cross-ref structure. If a future paper needs that, port the
#              kramdown extensions from ~/src/neurips/bin/build (lines 75–480
#              there) and route around pandoc.
#   - Skipped: LaTeX target. T&F provides only Word templates for Inquiry;
#              there is no T&F LaTeX class to compile against. Word is the
#              preferred submission format anyway.
#
# Usage:
#   bin/build                                # cwd-aware; if cwd is a paper-dir, build all OUT.*.md manifests
#   bin/build <paper-dir>                    # all OUT.*.md manifests in <paper-dir>
#   bin/build <paper-dir> <manifest-stem>    # specific manifest
#   bin/build <manifest-stem>                # specific manifest in cwd (cwd must be a paper-dir)
#
#   <paper-dir>      e.g., 03-inquiry-ai-agents
#   <manifest-stem>  reads OUT.<stem>.md (e.g., `inquiry-ai-agents-2026`).
#
# Output layout (per (paper, manifest) pair):
#   <paper>/.build/<stem>/<stem>.md             DOCX-intent markdown (intermediate)
#   <paper>/.build/<stem>/<stem>.pdf-preview.md PDF-intent markdown (intermediate; keywords stripped)
#   <paper>/.build/<stem>/<stem>.references.bib auto-emitted by `bin/refs emit`
#   <paper>/<stem>.docx                         primary submission artifact (Word)
#   <paper>/<stem>.pdf                          preview PDF (for self-review)
#   <paper>/<stem>.md                           assembled markdown (readable form of the
#                                                final paper; carries a banner identifying
#                                                it as a build output — sources live in src/)
#
# Conventions:
#   - meta.md in <paper-dir> root carries YAML frontmatter (title, authors,
#     abstract, keywords) + body abstract. Same shape as the NeurIPS pipeline.
#   - OUT.<stem>.md is a markdown table whose rows enumerate segments under
#     <paper-dir>/src/. Same shape as NeurIPS. The build does not invent a
#     new manifest format — minimum-viable port reuses the existing one.
#   - Anonymisation lint reads refs/deny-list.yml against each segment's
#     source text. Findings printed at end of build; non-fatal.
#
# Shells out to `bin/refs emit <paper-dir> --output <bib>` for the bib;
# shells out to `pandoc` for DOCX and PDF. Pandoc 3.x with the
# citation-style-language CSL (chicago-author-date.csl, system-installed at
# /usr/local/texlive/2025/texmf-dist/.../chicago-author-date.csl) handles
# citations natively via `--citeproc`.

require "yaml"
require "fileutils"
require "open3"
require "pathname"

ROOT     = Pathname.new(__dir__).parent.expand_path
REFS_BIN = ROOT / "bin" / "refs"

# Bibliography source. As of 2026-05-30 the canonical citation store for this
# portfolio is `relata` (~/src/relata/, on PATH via mise) — the local
# `refs/entries/` are stale (e.g. paper-4 resolves only 2 of 16 keys there,
# 16/16 via relata). relata's pandoc scanner reads this build's `[@key]`
# syntax and honors per-entry `emit_block: true` (e.g. the unconfirmed Emerson
# entry is skipped). Prefer `relata emit`; fall back to `bin/refs emit` only if
# relata is not on PATH (which is then surfaced loudly, since the local bib is
# known-stale). Override with REFS_EMITTER=refs to force the local emitter.
RELATA_BIN = ENV.fetch("RELATA_BIN") do
  found = `command -v relata 2>/dev/null`.strip
  found.empty? ? nil : found
end

# Chicago author-date CSL — T&F house style for Inquiry. Falls back to
# pandoc's bundled default if the texlive copy isn't present.
CSL_CANDIDATES = [
  "/usr/local/texlive/2025/texmf-dist/tex/latex/citation-style-language/styles/chicago-author-date.csl",
  "/usr/local/texlive/2024/texmf-dist/tex/latex/citation-style-language/styles/chicago-author-date.csl",
  "/Library/TeX/texbin/../texlive/styles/chicago-author-date.csl"
].freeze

def csl_path
  CSL_CANDIDATES.find { |p| File.exist?(p) }
end

# ─────────────────────────────────────────────────────────────────────────────
# Manifest & meta — shape matches the NeurIPS pipeline so OUT.*.md / meta.md
# files are portable. Authors familiar with the NeurIPS layout don't have to
# re-learn anything.
# ─────────────────────────────────────────────────────────────────────────────

class Manifest
  Row = Struct.new(:section, :type, :slug, :path, :title, :stage, keyword_init: true)

  attr_reader :rows

  def initialize(manifest_path)
    @path = manifest_path
    @rows = parse
  end

  private

  def parse
    rows  = []
    state = :outside
    @path.each_line do |line|
      next unless line.start_with?("|")

      cells = parse_row(line)
      next unless cells

      case state
      when :outside then state = :header
      when :header  then state = (separator?(cells) ? :data : :outside)
      when :data    then rows << build_row(cells)
      end
    end
    rows.compact
  end

  def parse_row(line)
    return nil unless line.strip.start_with?("|")

    line.strip.split("|")[1..-2]&.map(&:strip)
  end

  def separator?(cells) = cells.all? { |c| c.match?(/\A:?-+:?\z/) }

  def build_row(cells)
    section    = cells[0]
    type       = cells[1]&.downcase
    slug, path = extract_link(cells[2])
    return nil unless slug

    Row.new(section: section, type: type, slug: slug, path: path,
            title: cells[3], stage: cells[4])
  end

  def extract_link(cell)
    m = cell&.match(/\[(?<label>[^\]]*)\]\((?<path>[^)]+)\)/)
    return [nil, nil] unless m

    [m[:label], m[:path]]
  end
end

class Meta
  attr_reader :title, :authors, :abstract, :keywords, :data

  def initialize(meta_path)
    raw = meta_path.read
    if raw.start_with?("---\n")
      _, frontmatter, body = raw.split(/^---\n/, 3)
      @data     = YAML.safe_load(frontmatter) || {}
      @title    = @data["title"] || ""
      @authors  = @data["authors"] || []
      @keywords = @data["keywords"] || []
      @abstract = body.strip
    else
      @data, @title, @authors, @keywords = {}, "", [], []
      @abstract = raw.strip
    end
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# AnonymizationFilter — pre-processes segment text before assembly.
#
# Two marker types (both pass through pandoc harmlessly as HTML comments when
# the filter hasn't been applied, so sources read cleanly either way):
#
#   Inline swap: <!--ANON: anon-text -->deanon-text<!--/ANON-->
#     Anon mode:    → anon-text
#     Non-anon mode:→ deanon-text (markers stripped)
#
#   Block exclusion: <!--DEANON_ONLY-->...<!--/DEANON_ONLY-->
#     Anon mode:    → "" (entire block removed)
#     Non-anon mode:→ content (markers stripped)
#
# Global substitutions from refs/deny-list.yml `substitutions:` key are
# applied first in anon mode — they handle the bulk of author-name swaps
# (self-citations, email address) without requiring inline markers in source.
# ─────────────────────────────────────────────────────────────────────────────

module AnonymizationFilter
  INLINE_RE    = /<!--ANON:\s*(.*?)\s*-->(.*?)<!--\/ANON-->/m
  BLOCK_RE     = /<!--DEANON_ONLY-->(.*?)<!--\/DEANON_ONLY-->/m
  # Format markers are applied per-output-format in write_intermediate, after
  # the anon pass. They control content that should appear only in the PDF
  # preview or only in the DOCX submission — e.g. \newpage / review notices
  # in PDF, raw OpenXML page breaks and Article title restatement in DOCX.
  PDF_ONLY_RE  = /<!--PDF_ONLY-->(.*?)<!--\/PDF_ONLY-->/m
  DOCX_ONLY_RE = /<!--DOCX_ONLY-->(.*?)<!--\/DOCX_ONLY-->/m

  def self.call(text, substitutions, anon:)
    if anon
      text = apply_substitutions(text, substitutions)
      text = text.gsub(INLINE_RE) { Regexp.last_match(1) }
      text = text.gsub(BLOCK_RE, "")
    else
      text = text.gsub(INLINE_RE) { Regexp.last_match(2) }
      text = text.gsub(BLOCK_RE)  { Regexp.last_match(1) }
    end
    text
  end

  def self.apply_format_markers(text, pdf_preview:)
    if pdf_preview
      text = text.gsub(PDF_ONLY_RE)  { Regexp.last_match(1) }
      text = text.gsub(DOCX_ONLY_RE, "")
    else
      text = text.gsub(PDF_ONLY_RE, "")
      text = text.gsub(DOCX_ONLY_RE) { Regexp.last_match(1) }
    end
    text
  end

  def self.apply_substitutions(text, substitutions)
    Array(substitutions).each { |s| text = text.gsub(s["from"], s["to"]) }
    text
  end
  private_class_method :apply_substitutions
end

# ─────────────────────────────────────────────────────────────────────────────
# Builder — orchestrates concat + refs emit + pandoc DOCX + pandoc PDF.
# ─────────────────────────────────────────────────────────────────────────────

class Builder
  def initialize(paper_dir, manifest_stem, anon: false)
    @paper_dir     = paper_dir.is_a?(Pathname) ? paper_dir.expand_path : (ROOT / paper_dir).expand_path
    @manifest_stem = manifest_stem
    @anon          = anon
    @build_dir     = @paper_dir / ".build" / @manifest_stem
    @lint_findings = []
  end

  def call
    raise "paper dir not found: #{@paper_dir}" unless @paper_dir.directory?

    meta     = Meta.new(meta_path)
    manifest = Manifest.new(@paper_dir / "OUT.#{@manifest_stem}.md")

    FileUtils.mkdir_p(@build_dir)
    bib_path             = emit_references_bib
    assert_anon_safe_bib(bib_path)
    docx_md_path, pdf_md_path = assemble_markdown(meta, manifest)

    docx_path = render_docx(docx_md_path, bib_path)
    pdf_path  = render_pdf_preview(pdf_md_path, bib_path)

    publish(docx_path, pdf_path)
    report_lint
    report_success(docx_path, pdf_path)
  end

  private

  # Output stem for published files. Appends "-anon" in anonymised mode so
  # anon and non-anon builds coexist without overwriting each other.
  def output_stem
    @anon ? "#{@manifest_stem}-anon" : @manifest_stem
  end

  # Frontmatter source. A paper-dir can host several manifest stems. Stems
  # that are *revisions of one paper* (e.g. `inquiry-ai-agents-2026` and its
  # `granted-agency` rewrite) share one identity — same title, same keywords —
  # so they share the dir-level `meta.md`. A stem that is a *distinct paper*
  # in the same dir needs its own title; drop a `meta.<stem>.md` beside the
  # manifest and it takes precedence. `meta.md` remains the fallback, so this
  # is invisible to every existing stem.
  def meta_path
    per_stem = @paper_dir / "meta.#{@manifest_stem}.md"
    per_stem.file? ? per_stem : @paper_dir / "meta.md"
  end

  # Substitution pairs from refs/deny-list.yml `substitutions:` key.
  # Loaded lazily alongside the deny-list; shares the @deny_list cache.
  def anon_substitutions
    @deny_list ||= load_deny_list
    Array(@deny_list&.dig("substitutions"))
  end

  # Lands the bib in our build dir; pandoc consumes it via --bibliography.
  # Same atomicity discipline as the NeurIPS pipeline (process-isolated;
  # emitter-side bug surfaces here as a build error rather than a silent
  # partial bib).
  #
  # Source: `relata emit` (canonical, fresh, emit_block-aware) unless
  # REFS_EMITTER=refs or relata is absent, in which case the stale local
  # `bin/refs emit` is used with a loud warning. Both emitters report a
  # trailing "(N entries; M missing)" line on success; any M>0 (unresolved
  # cited key) is a HARD failure for a submission build, so we parse it and
  # raise rather than silently shipping a bib with holes.
  def emit_references_bib
    output = @build_dir / "#{@manifest_stem}.references.bib"

    forced_refs = ENV["REFS_EMITTER"].to_s.downcase == "refs"
    use_relata  = RELATA_BIN && !forced_refs

    if use_relata
      cmd = [RELATA_BIN, "emit", @paper_dir.to_s, "--output", output.to_s]
    else
      warn "  [bib] WARNING: emitting with stale local bin/refs " \
           "(#{RELATA_BIN ? "REFS_EMITTER=refs forced" : "relata not on PATH"}) — " \
           "local refs/entries/ is known-stale; verify the bib." unless forced_refs
      cmd = [REFS_BIN.to_s, "emit", @paper_dir.to_s, "--output", output.to_s]
    end

    out, status = Open3.capture2e(*cmd)
    emitter = use_relata ? "relata emit" : "bin/refs emit"
    raise "#{emitter} failed:\n#{out}" unless status.success?

    if (m = out.match(/\((\d+)\s+entr(?:y|ies);\s+(\d+)\s+missing\)/))
      missing = m[2].to_i
      raise "#{emitter} reports #{missing} unresolved cited key(s) — " \
            "bib has holes; not safe to build:\n#{out}" if missing.positive?
    end

    output
  end

  # Hard anonymisation gate on the EMITTED bib (anon builds only).
  #
  # The anon filter rewrites segment *text*, but the bibliography is rendered
  # by pandoc citeproc straight from this .bib — which the filter never
  # touches. So a live `[@key]` pointing at a deny-listed entry (e.g. a
  # `Wecker`-authored companion) silently renders the real name into the anon
  # bibliography AND its in-text cite — exactly the deanonymisation that
  # double-blind exists to prevent. The segment-text lint structurally cannot
  # see this: the offending name lives only in the bib, never in the prose.
  # `relata lint` detects it, but as a separate manual step; enforcing it here
  # makes the build itself refuse to ship a deanonymising bib, the same
  # hard-fail discipline already applied to unresolved keys.
  #
  # Remediation is a citation decision, NOT a silently-rewritten bib: an
  # in-review/in-prep companion self-cite belongs in a plain-text footnote
  # ("(Wecker, in review, 2026)", anon-substituted to "Author, …") rather
  # than a `[@key]` — see bin/build.README.md "Conventions worth knowing".
  # Anonymising only the author is insufficient: the entry's title/journal
  # stay matchable under double-blind, so the safe form carries no bib entry
  # at all (dropping the `[@key]` drops the entry, since emit is cite-driven).
  #
  # Scope: deny-listed authors + DOIs only. Proper-noun-in-title is left to
  # `relata lint`'s title-scoped check — matching whole-entry text here would
  # false-positive on legitimate author names that collide with cohort nouns
  # (e.g. "Soren", "Resonance") and wrongly block a clean build. Surname
  # matching can itself false-positive on a genuinely-unrelated "Wecker"; the
  # deny-list comment treats author hits as surface-for-triage, so an escape
  # hatch (`ANON_BIB_GATE=warn`) downgrades to a loud warning for that case
  # rather than trapping a future build with no override.
  def assert_anon_safe_bib(bib_path)
    return unless @anon
    @deny_list ||= load_deny_list
    return unless @deny_list && bib_path.exist?

    bib = bib_path.read
    violations = []
    bib_entries(bib).each do |key, body|
      Array(@deny_list["authors"]).each do |a|
        violations << "#{key}: deny-listed author '#{a}' in emitted bib entry" if body.match?(/\b#{Regexp.escape(a)}\b/)
      end
      Array(@deny_list["dois"]).each do |doi|
        violations << "#{key}: deny-listed DOI '#{doi}' in emitted bib entry" if body.include?(doi)
      end
    end
    return if violations.empty?

    message = <<~MSG.rstrip
      ANON build would deanonymise via the bibliography. The emitted bib
      (#{bib_path.relative_path_from(ROOT)}) contains deny-listed content that
      pandoc citeproc renders into the anon bibliography and in-text cites:

      #{violations.map { |v| "  - #{v}" }.join("\n")}

      Fix (a citation decision, not a bib rewrite): replace the offending
      `[@key]` cite(s) with a plain-text footnote — e.g. "(Wecker, in review,
      2026)", anon-substituted to "Author, …" — not a live citation. Dropping
      the [@key] drops the entry from the emitted bib. See bin/build.README.md
      "Conventions worth knowing". If a flagged author is genuinely unrelated
      to this project, set ANON_BIB_GATE=warn to downgrade this to a warning.
    MSG

    raise message unless ENV["ANON_BIB_GATE"].to_s.downcase == "warn"

    warn "── ANON bib gate (downgraded via ANON_BIB_GATE=warn) ──\n#{message}"
  end

  # Split a BibTeX string into [key, entry-body] pairs so a deny-list hit can
  # be attributed to a specific bibkey. Minimal — just enough for the
  # anon-safety gate; not a general BibTeX parser.
  def bib_entries(text)
    text.scan(/@\w+\s*\{\s*([^,]+),(.*?)(?=\n@\w+\s*\{|\z)/m)
        .map { |key, body| [key.strip, body] }
  end

  # Concatenate manifest segments into intermediate markdown. Two writer
  # outputs need slightly-different YAML frontmatter, so we factor body
  # assembly once and write two intermediates:
  #
  #   - <stem>.md              — for DOCX (full frontmatter incl. keywords)
  #   - <stem>.pdf-preview.md  — for PDF preview (keywords stripped; see
  #                              render_pdf_preview for the lualatex/xmp
  #                              rationale)
  #
  # Body assembly is identical for both; the abstract source is also shared.
  # An abstract row in the manifest (slug == "abstract") is *lifted* into the
  # YAML `abstract:` field rather than concatenated into the body — without
  # this we double-render (meta.md placeholder body + the lifted file). See
  # lift_abstract for the convention.
  #
  # Bibliography rows are absorbed by `--citeproc` (rendered after a
  # `# References {-}` heading we append below).
  def assemble_markdown(meta, manifest)
    abstract_text = lift_abstract(manifest) || meta.abstract.to_s.gsub(/\s+/, " ").strip
    body = build_body(manifest)

    docx_md = write_intermediate("#{@manifest_stem}.md",             meta, abstract_text, body, omit_keywords: false, pdf_preview: false)
    pdf_md  = write_intermediate("#{@manifest_stem}.pdf-preview.md", meta, abstract_text, body, omit_keywords: true,  pdf_preview: true)
    [docx_md, pdf_md]
  end

  def write_intermediate(filename, meta, abstract_text, body, omit_keywords:, pdf_preview:)
    path = @build_dir / filename
    body = AnonymizationFilter.apply_format_markers(body, pdf_preview: pdf_preview)
    md = +""
    md << render_yaml_frontmatter(meta, abstract_text, omit_keywords: omit_keywords)
    md << "\n\n"
    md << body
    path.write(md)
    path
  end

  def build_body(manifest)
    body = +""
    manifest.rows.each do |row|
      next if skip_in_body?(row)
      if row.type == "bibliography"
        # Emit the heading + the empty `{#refs}` fenced div at the row's
        # manifest position. Pandoc citeproc looks for a div with id `refs`
        # as its placement marker (NOT for a heading whose text is
        # "References" — that is a common misreading of the docs); without
        # the explicit div pandoc places the bibliography at end-of-document
        # by default, leaving the manifest-position heading orphaned and the
        # rendered entries headless. The fenced div pins placement at the
        # row's manifest position so e.g. Bibliography between Conclusion
        # and Back-matter renders the way the manifest declares.
        body << "# References {-}\n\n::: {#refs}\n:::\n\n"
        next
      end
      body << render_segment(row) << "\n\n"
    end
    body
  end

  # Rows the body skips: checklist (NeurIPS-only) and the abstract row (lifted
  # into the YAML `abstract:` field by lift_abstract; concatenating it as well
  # would double-render). Bibliography rows are NOT skipped here — build_body
  # handles them by emitting the `# References {-}` heading at the row's
  # position so pandoc citeproc places the rendered bibliography there.
  def skip_in_body?(row)
    return true if row.type == "checklist"
    return true if abstract_row?(row)

    false
  end

  def abstract_row?(row)
    row.slug.to_s.downcase == "abstract"
  end

  # Read the abstract row's source file and use its prose as the YAML abstract,
  # overriding whatever placeholder lives in meta.md. Convention: the file may
  # carry a leading H1 (structural) and italic-bracketed drafter notes
  # (workflow); both are stripped, and the remaining paragraphs become the
  # abstract metadata. Citations inside the abstract (`[-@key]`, `@key`) are
  # processed by pandoc citeproc when rendered from a metadata field, so this
  # path keeps the abstract's bibliography integrated.
  #
  # Returns nil if no abstract row is declared, the file is missing, or the
  # file collapses to empty after stripping — in any of those cases the caller
  # falls back to meta.md's body.
  def lift_abstract(manifest)
    row = manifest.rows.find { |r| abstract_row?(r) }
    return nil unless row

    src = @paper_dir / row.path
    return nil unless src.exist?

    text = AnonymizationFilter.call(src.read, anon_substitutions, anon: @anon)
    lint_anonymisation(text, row.path)

    paragraphs = text.split(/\n\s*\n/)
    paragraphs = paragraphs.drop_while { |p| abstract_preamble?(p) }
    cleaned = paragraphs.join("\n\n").strip.gsub(/\s+/, " ")
    cleaned.empty? ? nil : cleaned
  end

  def abstract_preamble?(paragraph)
    s = paragraph.strip
    return true if s.empty?
    return true if s.start_with?("#")                                          # H1/H2/etc. heading
    return true if s.start_with?("*") && s.end_with?("*") && !s.start_with?("**") && s.length > 2  # italic-only drafter note

    false
  end

  def render_yaml_frontmatter(meta, _abstract_text, omit_keywords:)
    fm = {
      "title" => meta.title,
      "lang"  => meta.data["lang"] || "en-GB"      # British English per T&F style
      # NB: do NOT set `reference-section-title` here — see build_body comment.
    }
    # keywords: kept in YAML for DOCX document-property metadata only; they are
    # NOT rendered as visible body text by pandoc's DOCX writer. Visible keywords
    # appear in src/00-abstract.md using {custom-style="Keywords"}.
    fm["keywords"] = meta.keywords if !omit_keywords && meta.keywords.any?
    # abstract and author details are rendered as body content via
    # src/00-abstract.md and src/00-author-details.md using custom-style fenced
    # divs, so pandoc lays them out in correct T&F order:
    #   [deanon: Author names → Affiliation → Correspondence]
    #   Abstract (Abstract style) → Keywords → §1 body
    # Removing them from YAML also removes pandoc's automatic "Abstract" heading
    # and the fixed author→abstract ordering that YAML metadata imposes.
    "---\n#{YAML.dump(fm).sub(/\A---\n/, '')}---"
  end

  def render_segment(row)
    src_path = @paper_dir / row.path
    raise "segment not found: #{src_path}" unless src_path.exist?

    content = AnonymizationFilter.call(src_path.read, anon_substitutions, anon: @anon)
    lint_anonymisation(content, row.path)
    content
  end

  def render_docx(md_path, bib_path)
    out = @build_dir / "#{output_stem}.docx"
    cmd = pandoc_cmd_base(md_path, bib_path) + ["--output", out.to_s]
    if (ref = reference_doc_path)
      cmd += ["--reference-doc", ref.to_s]
      @reference_doc_used = ref
    end
    run_pandoc(cmd, "pandoc → docx")
    out
  end

  # Reference doc for DOCX styling. Pandoc reads named styles, page setup,
  # margins, and fonts from this file (body content is generated from
  # markdown). Precedence: per-paper override → portfolio default → none
  # (pandoc's built-in defaults). Per-paper override exists so a venue-
  # specific template (e.g. a future Synthese / Springer Word file at
  # `01-synthese-asymmetric-comprehension/reference.docx`) can sit alongside
  # the portfolio default at `common/reference.docx`.
  #
  # The currently-staged `common/reference.docx` is Taylor & Francis's
  # generic Word template (`TF_Template_Word_Windows_2016.dotx`, archived
  # untouched at `common/vendor/`); the .dotx was renamed to .docx because
  # pandoc accepts the OOXML payload either way and the .docx extension keeps
  # the convention boring.
  #
  # Style-name caveat: the T&F template uses some non-pandoc style names
  # (`Article title` vs pandoc's `Title`; `Author names` vs `Author`;
  # `Displayed quotation` vs `Block Text`; `References` vs `Bibliography`).
  # Those four don't auto-map; everything pandoc does map by name (Normal /
  # Heading 1–4 / Abstract / Keywords / Footnote Text / etc.) flows through
  # cleanly. To get the unmapped four, edit `common/reference.docx` in Word
  # and add the pandoc-name as an alias on the matching T&F style — that is
  # styling-decision territory, not a pipeline change.
  def reference_doc_path
    [@paper_dir / "reference.docx", ROOT / "common" / "reference.docx"].find(&:exist?)
  end

  # PDF preview via pandoc + lualatex. T&F doesn't ship a class for Inquiry,
  # so this is *not* a submission artifact — it's a self-review preview only.
  # Submission goes via the DOCX. If lualatex isn't available, the PDF target
  # is skipped (warning, not failure) — DOCX alone is enough for submission.
  #
  # NB: this consumes the `*.pdf-preview.md` intermediate (built without a
  # `keywords:` YAML field), not the `*.md` intermediate. An earlier attempt
  # to override keywords with `--metadata=keywords:` on the CLI silently
  # failed: pandoc accepts the override but the YAML list still flows into
  # the LaTeX template's `$for(keywords)$\xmpquote{...}$endfor$` block via
  # the hyperxmp package, fatalling lualatex on the first run. Stripping the
  # field at YAML-assembly time is the actual fix; the DOCX writer still
  # gets keywords through its own intermediate.
  def render_pdf_preview(md_path, bib_path)
    out = @build_dir / "#{output_stem}.pdf"
    cmd = pandoc_cmd_base(md_path, bib_path) + [
      "--pdf-engine=lualatex",
      # Camera-ready-style typesetting for the preview PDF. The submission
      # target is always DOCX; this PDF is for self-review and reading.
      "-V", "geometry:margin=1.25in",
      "-V", "fontsize=11pt",
      "-V", "linestretch=1.1",       # near single-spaced; readable without review bloat
      "-V", "documentclass=article",
      "-V", "indent=true",           # journal-style paragraph indentation
      "-V", "colorlinks=true",
      "-V", "linkcolor=NavyBlue",
      "-V", "urlcolor=NavyBlue",
      "-V", "citecolor=NavyBlue",
      "-V", "mainfont=TeX Gyre Pagella",   # Palatino-style; falls back to LM if absent
      "--output", out.to_s
    ]
    begin
      run_pandoc(cmd, "pandoc → pdf preview")
      out
    rescue StandardError => e
      warn "pdf preview skipped: #{e.message.lines.first&.strip}"
      nil
    end
  end

  def pandoc_cmd_base(md_path, bib_path)
    cmd = [
      "pandoc",
      md_path.to_s,
      "--from=markdown+yaml_metadata_block+citations+smart",
      "--bibliography=#{bib_path}",
      "--citeproc",
      "--metadata=link-citations:true"
    ]
    cmd += ["--csl", csl_path] if csl_path
    cmd
  end

  def run_pandoc(cmd, label)
    out, status = Open3.capture2e(*cmd)
    raise "#{label} failed:\n#{out.lines.last(40).join}" unless status.success?

    # Surface pandoc's warnings even on success. Pandoc only writes to stderr
    # for warnings / errors / progress (not chatty info), so anything captured
    # here is signal worth showing the drafter — most importantly the
    # `[WARNING] Note with key 'X' defined ... but not used` line, which
    # silently drops the orphan footnote AND its citations from the rendered
    # output (so cited entries land in the .bib via `bin/refs` but are absent
    # from the rendered bibliography). Surfaced 2026-05-10 by paper 3's
    # `[^shared-space-source]` footnote being defined but never invoked,
    # which dropped Tomasello-2014 and Honneth-1995 from the references
    # section of the rendered DOCX/PDF without any visible build-time signal.
    warn out unless out.strip.empty?
  end

  def publish(docx_path, pdf_path)
    FileUtils.cp(docx_path, @paper_dir / docx_path.basename) if docx_path&.exist?
    FileUtils.cp(pdf_path, @paper_dir / pdf_path.basename) if pdf_path&.exist?
    publish_assembled_markdown
  end

  # Publish the DOCX-intent assembled markdown alongside the .docx / .pdf so a
  # human (or future agent) can read the whole paper in one place without
  # digging into `.build/` or extracting prose from a Word file. Also useful
  # for grep, diff, share-with-colleagues, and quick word-counts. We publish
  # the DOCX-intent intermediate (the one with full frontmatter incl.
  # keywords); the PDF-intent variant differs only by the stripped keywords
  # field, and one published copy is enough.
  #
  # A banner comment was previously injected after the YAML frontmatter to
  # mark the file as a build output; it surfaced as a submission-time
  # artefact on de-novo audits (reviewers reading the assembled .md saw it as
  # a stray "internal build comment" near the top of the manuscript). The
  # banner has been moved into the YAML frontmatter as a `_build:` field —
  # invisible in any rendered output (pandoc's docx/pdf writers ignore
  # unknown YAML keys) and still discoverable by anyone opening the file.
  def publish_assembled_markdown
    src = @build_dir / "#{@manifest_stem}.md"
    return unless src.exist?

    dst = @paper_dir / "#{output_stem}.md"
    dst.write(with_build_banner(src.read))
    @assembled_md_published = dst
  end

  def with_build_banner(content)
    anon_note    = @anon ? " ANONYMISED build — author identity stripped." : ""
    banner_value = "Built by bin/build from src/*.md per OUT.#{@manifest_stem}.md.#{anon_note} " \
                   "Source-of-truth lives in src/; edits to this file are overwritten on the next build."

    # Inject `_build:` into the YAML frontmatter so the marker travels with
    # the file but never surfaces in body text. If for any reason the file
    # has no frontmatter, return the content unchanged.
    if content.start_with?("---\n")
      parts = content.split(/^---\n/, 3)
      if parts.length >= 3
        new_frontmatter = parts[1].sub(/\A/, "_build: #{banner_value.inspect}\n")
        "---\n#{new_frontmatter}---\n\n#{parts[2].lstrip}"
      else
        content
      end
    else
      content
    end
  end

  def report_success(docx_path, pdf_path)
    [docx_path, pdf_path].compact.each do |p|
      rel = (@paper_dir / p.basename).relative_path_from(ROOT)
      puts "✓ #{rel}"
    end
    if @assembled_md_published
      puts "✓ #{@assembled_md_published.relative_path_from(ROOT)}"
    end
    if @reference_doc_used
      puts "  (docx styled from #{@reference_doc_used.relative_path_from(ROOT)})"
    end
  end

  # Build-time anonymisation scan. Mirrors the NeurIPS pipeline's
  # `lint_anonymization` (NeurIPS bin/build §lint_anonymization). Reads
  # refs/deny-list.yml and surfaces any deny-listed term, DOI, or author
  # surname appearing in a manifest-included segment. Non-fatal —
  # `bin/refs lint` is the hard gate; this is the early-warning at draft
  # time so an agent doesn't accumulate violations across hours of drafting.
  def lint_anonymisation(text, source_path)
    @deny_list ||= load_deny_list
    return unless @deny_list

    Array(@deny_list["dois"]).each do |doi|
      @lint_findings << "#{source_path}: deny-listed DOI present: #{doi}" if text.include?(doi)
    end
    Array(@deny_list["authors"]).each do |surname|
      @lint_findings << "#{source_path}: self-cite-flag surname '#{surname}' present (verify third-person framing)" if text.match?(/\b#{Regexp.escape(surname)}\b/)
    end
    Array(@deny_list["proper_nouns"]).each do |name|
      @lint_findings << "#{source_path}: anonymisation vocab '#{name}' present (must not appear in submitted file)" if text.match?(/\b#{Regexp.escape(name)}\b/)
    end
  end

  def load_deny_list
    path = ROOT / "refs" / "deny-list.yml"
    return nil unless path.exist?

    YAML.safe_load_file(path)
  end

  def report_lint
    return if @lint_findings.empty?

    warn "── Lint findings (#{@lint_findings.size}) — non-fatal; `bin/refs lint` is the hard gate ──"
    @lint_findings.each { |f| warn "  #{f}" }
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# CLI dispatcher — same shape as ~/src/neurips/bin/build's CLI for muscle-
# memory carry-over. Heuristic for paper-dir detection: directory has both a
# meta.md and at least one OUT.*.md.
# ─────────────────────────────────────────────────────────────────────────────

class CLI
  USAGE = <<~USAGE.freeze
    bin/build — assemble a paper from an OUT.*.md manifest into DOCX (T&F primary) + PDF preview.

    By default both the standard and anonymised builds are produced together.

    Usage:
      bin/build [flags] <paper-dir> <manifest-stem>    # specific manifest
      bin/build [flags] <paper-dir>                    # all OUT.*.md manifests in <paper-dir>
      bin/build [flags] <manifest-stem>                # specific manifest in cwd
      bin/build [flags]                                # cwd-aware default (cwd must be a paper-dir)

    Flags:
      (default)    Build both standard and anonymised versions.
      --no-anon    Build standard version only.
      --anon       Build anonymised version only (alias: --just-anon).
      --just-anon  Build anonymised version only.

    Anonymised output strips author identity (frontmatter, self-citations,
    ANON/DEANON_ONLY markers per refs/deny-list.yml) and is named
    <stem>-anon.{docx,pdf,md}.

    Output: <paper-dir>/<stem>.docx (submission) and <paper-dir>/<stem>.pdf (preview).
  USAGE

  def self.run(argv) = new.dispatch(argv)

  def dispatch(argv)
    no_anon   = !!argv.delete("--no-anon")
    just_anon = !!(argv.delete("--just-anon") || argv.delete("--anon"))
    @build_mode = no_anon ? :deanon_only : (just_anon ? :anon_only : :both)

    pairs =
      case argv.length
      when 0 then resolve_no_args
      when 1 then resolve_one_arg(argv[0])
      when 2 then [[resolve_paper_dir(argv[0]), argv[1]]]
      else        usage_and_exit("too many arguments")
      end

    abort_with_usage("no manifests resolved") if pairs.empty?
    run_pairs(pairs)
  end

  private

  def paper_dir?(path)
    return false unless path&.directory?

    (path / "meta.md").exist? && !path.glob("OUT.*.md").empty?
  end

  def manifests_in(paper_dir)
    paper_dir.glob("OUT.*.md").sort.map { |p| p.basename.to_s.delete_prefix("OUT.").delete_suffix(".md") }
  end

  def resolve_no_args
    cwd = Pathname.pwd.expand_path
    return manifests_in(cwd).map { |s| [cwd, s] } if paper_dir?(cwd)

    candidates = ROOT.glob("0?-*").select { |p| paper_dir?(p) }.sort
    listing    = candidates.map { |c| c.relative_path_from(ROOT) }.join("\n  ")
    abort_with_usage("cwd is not a paper-dir (no meta.md / OUT.*.md). Candidate paper-dirs:\n  #{listing}")
  end

  def resolve_one_arg(arg)
    candidate_dir = Pathname.new(arg).expand_path
    candidate_dir = ROOT / arg unless candidate_dir.directory?
    return manifests_in(candidate_dir).map { |s| [candidate_dir, s] } if paper_dir?(candidate_dir)

    cwd = Pathname.pwd.expand_path
    if paper_dir?(cwd) && (cwd / "OUT.#{arg}.md").exist?
      [[cwd, arg]]
    else
      abort_with_usage("`#{arg}` is neither a paper-dir nor a manifest stem in cwd #{cwd.relative_path_from(ROOT)}")
    end
  end

  def resolve_paper_dir(arg)
    candidate = Pathname.new(arg).expand_path
    candidate = ROOT / arg unless candidate.directory?
    abort_with_usage("not a paper-dir: #{arg}") unless paper_dir?(candidate)

    candidate
  end

  def run_pairs(pairs)
    anon_modes = case @build_mode
                 when :deanon_only then [false]
                 when :anon_only   then [true]
                 when :both        then [false, true]
                 end

    # Isolate errors when there are multiple builds (multiple pairs or both modes)
    # so one failure doesn't abort the rest.
    isolate   = pairs.size > 1 || @build_mode == :both
    successes = []
    failures  = []

    pairs.each do |paper_dir, stem|
      anon_modes.each do |anon|
        label = "#{paper_dir.relative_path_from(ROOT)}/#{stem}#{anon ? " (anon)" : ""}"
        if isolate
          begin
            Builder.new(paper_dir, stem, anon: anon).call
            successes << label
          rescue StandardError => e
            warn "✗ #{label}: #{e.message.lines.first&.strip}"
            failures << [label, e]
          end
        else
          Builder.new(paper_dir, stem, anon: anon).call
          successes << label
        end
      end
    end

    print_summary(successes, failures) if isolate
    exit 1 if failures.any?
  end

  def print_summary(successes, failures)
    puts
    puts "── Build summary ──"
    successes.each { |s| puts "  ✓ #{s}" }
    failures.each  { |label, e| puts "  ✗ #{label}: #{e.message.lines.first&.strip}" }
    puts "  (#{successes.size} passed, #{failures.size} failed)"
  end

  def usage_and_exit(msg = nil)
    warn msg if msg
    warn USAGE
    exit 1
  end

  def abort_with_usage(msg)
    warn msg
    warn
    warn USAGE
    exit 1
  end
end

CLI.run(ARGV) if $PROGRAM_NAME == __FILE__
