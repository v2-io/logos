.DS_Store

# refs/ — citation system: entries + verifications + deny-list are tracked;
# PDFs are large + likely copyrighted; _emitted/ is generated artifact.
refs/pdfs/*
!refs/pdfs/.gitkeep
refs/_emitted/
.obsidian/

# Per-paper build artifacts (generated by bin/build).
# Stay in the working tree for inspection; never committed.
0?-*/.build/
0?-*/*.docx
0?-*/*.pdf
0?-*/refs.bib

# Assembled-from-segments markdown is a build artifact (mirrors the .docx/.pdf).
# Source of truth lives in src/*.md.
0?-*/inquiry-ai-agents-*.md
0?-*/synthese-asymmetric-*.md
0?-*/synthese-methodology-*.md
0?-*/inquiry-after-consciousness-*.md

# Per-paper scratch / tmp dirs (e.g., per-segment review thoughts)
0?-*/tmp-*/
